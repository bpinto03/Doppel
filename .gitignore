# Godot 4 cache, import data and export credentials (.godot/export_credentials.cfg)
.godot/
/android/

# Generated from ui.csv on import
*.translation

# Source assets kept out of the build (Godot skips the folder through its .gdignore)
/_sources/

# Build output
/build/
*.apk
*.aab
*.idsig

# Signing credentials must never be committed
*.keystore
*.jks
keystore.properties

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
.vscode/
.idea/
