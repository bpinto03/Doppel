[gd_resource type="Resource" script_class="ThemeCatalog" format=3]

[ext_resource type="Script" path="res://scripts/themes/theme_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/themes/theme_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/palette_paper.tres" id="3_paper"]
[ext_resource type="Resource" path="res://data/palette_night.tres" id="4_night"]

[sub_resource type="Resource" id="Resource_paper"]
script = ExtResource("2_entry")
id = &"paper"
palette = ExtResource("3_paper")
price = 0
display_name_key = "THEME_NAME_PAPER"
description_key = "THEME_DESC_PAPER"

[sub_resource type="Resource" id="Resource_night"]
script = ExtResource("2_entry")
id = &"night"
palette = ExtResource("4_night")
price = 0
display_name_key = "THEME_NAME_NIGHT"
description_key = "THEME_DESC_NIGHT"

[resource]
script = ExtResource("1_catalog")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_paper"), SubResource("Resource_night")])
default_id = &"paper"
